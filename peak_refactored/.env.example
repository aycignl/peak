# PEAK Environment Configuration
# Copy this file to .env and fill in your specific values

# Environment
PEAK_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=DEBUG

# API Keys
CLARIFAI_API_KEY=your_clarifai_api_key_here

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Database (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peak_db
DB_USER=peak_user
DB_PASSWORD=your_db_password

# File Paths
DATA_DIR=data/
MODELS_DIR=models/
LOGS_DIR=logs/
CACHE_DIR=cache/

# Performance
N_JOBS=-1  # Number of CPU cores to use (-1 for all)
MEMORY_LIMIT=2GB

# Web Configuration (if using web interface)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ENABLED=true
SSL_REQUIRED=false

# Model Configuration
N_TOPICS=5
MAX_FEATURES=1000
RANDOM_STATE=42

# Pipeline Configuration
TEST_SPLIT=0.2
VALIDATION_SPLIT=0.1
BATCH_SIZE=32

# Monitoring (optional)
ENABLE_MONITORING=false
METRICS_ENDPOINT=/metrics
HEALTH_ENDPOINT=/health